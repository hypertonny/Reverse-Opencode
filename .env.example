# ========================================================
# OpenCode Free Models Gateway Configuration
# ========================================================

# Proxy port
PORT=3000

# OpenCode official server mode URL (default: http://127.0.0.1:4096)
# The proxy communicates with opencode serve using your logged-in account
OPENCODE_SERVER_URL=http://127.0.0.1:4096

# Optional: Require API key from clients (Claude Code, Cline, etc.)
# If left empty, proxy accepts requests without key requirement
PROXY_API_KEY=

# Optional: Default reasoning effort (minimal | low | medium | high | max | xhigh)
DEFAULT_EFFORT=

# Logging file path (structured JSONL format)
LOG_FILE=./logs/requests.jsonl

# Policy: Only free models (muse-spark-1.3-contributor-free, big-pickle, etc.) are allowed.
# Set to true only if you explicitly want to unlock paid models.
ALLOW_PAID_MODELS=false

# Rate limiting & concurrency controls
RATE_LIMIT_RPM=240
MAX_CONCURRENT=16
MAX_BODY_BYTES=26214400
UPSTREAM_TIMEOUT_MS=180000
LOG_MAX_BYTES=52428800
